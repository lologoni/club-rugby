NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Coincide con docker-compose.yml
DATABASE_URL=postgres://club:club@localhost:5432/club_rugby
# En la nube suele hacer falta SSL
DB_SSL=false

# Generar uno propio, por ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambiar-esto
JWT_EXPIRES_IN=8h

# Credenciales de prueba de Mercado Pago (las carga Luca)
MP_ACCESS_TOKEN=
MP_WEBHOOK_URL=
